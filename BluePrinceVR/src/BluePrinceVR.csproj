<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>BluePrinceVR</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Blue Prince</GameDir>
    <NoWarn>$(NoWarn);MSB3277;MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Common.dll" />
    <Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" />
  </ItemGroup>
</Project>
